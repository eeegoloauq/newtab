{
  "manifest_version": 3,
  "name": "newtab (live)",
  "version": "1.0",
  "description": "Opens your own newtab server on every new tab.",
  "chrome_url_overrides": { "newtab": "newtab.html" },
  "options_page": "options.html",
  "action": { "default_title": "newtab: address", "default_popup": "options.html" },
  "permissions": ["storage"]
}
